- name: sweep_controller
  id: snippet
  parameters:
    alias: ''
    code: "import threading, time\n\ndef _sweep(tb):\n    # A flowgraph cannot draw\
      \ a sweep as wires, but it can carry the thread\n    # that drives one. Setting\
      \ the chooser variable is exactly what clicking\n      # it does: GRC's generated\
      \ set_chan() retunes the source and moves the\n    # centre frequency of every\
      \ display with it.\n    while True:\n        if getattr(tb, 'sweep_on', 0):\n\
      \            for f in tb.sweep_list:\n                if not getattr(tb, 'sweep_on',\
      \ 0):\n                    break\n                tb.set_chan(f)\n         \
      \       time.sleep(1.0)\n        else:\n            time.sleep(0.2)\n\nthreading.Thread(target=_sweep,\
      \ args=(self,), daemon=True).start()"
    comment: ''
    priority: '0'
    section: main_after_start
  states: {bus_sink: false, bus_source: false, bus_structure: null, coordinate: [1080,
      108], rotation: 0, state: enabled}

