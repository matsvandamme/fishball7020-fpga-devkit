The PlutoSky R2's FPGA design: pins, PL Ethernet and the reference PLL

Turns the tree's FPGA project, which is the PlutoSky R1's (XC7Z020-CLG400), into
the PlutoSky R2's (XC7Z020-CLG484). Applied FIRST on --rev r2, so the rest of
the series lands on the R2 design.

What it is: the hdl/ part of OpenSourceSDRLab's own R2 port,

    github.com/OpenSourceSDRLab/PlutoSky-R2
    firmware/source/plutosky-r2-plutosdr-fw-v0.38.patch

re-expressed against this repo's pinned tree. That tree is ADI's plutosdr-fw
v0.38 plus the vendor's R1 port - checked file by file on 2026-11-18: reversing
the vendor's R1 patch (PlutoSky_7020_AD936X_SDR) applies cleanly to it - so this
patch is "undo the R1 port's hdl/ changes, apply the R2 port's". The six files it
leaves are byte-identical to ADI hdl 1978df29 with the vendor's R2 patch applied.

What changes for the R2:
  system_project.tcl   the part: xc7z020clg484-2
  system_constr.xdc    every ball; RGMII and MDIO on bank 35; the PLL pins
  system_bd.tcl        the PS package (clg484); MIO bank 1 at LVCMOS 3.3 V, not
                       1.8 V; GEM0 and its MDIO on EMIO instead of MIO 16-27 and
                       52-53, into a gmii_to_rgmii core clocked from FCLK_CLK1
  system_top.v         the RGMII and PLL ports
  ADF4001_init.v, ADF4001_spi_drive.v   (new) program the ADF4001 that locks the
                       40 MHz oscillator to the 10M_IN reference

NOT carried from the vendor's R2 patch: its linux/, u-boot-xlnx/ and buildroot/
hunks. --rev r2 on the factory target builds the FPGA only; the R2's kernel and
device tree are the modern target's (firmware-modern/dts/*-r2.dts).

Licence: the modified files are Analog Devices' HDL, under ADI's licence terms
as before; the vendor's changes are distributed under the licence of each file
they modify (the vendor repo's NOTICE.md).

diff --git a/hdl/projects/pluto/ADF4001_init.v b/hdl/projects/pluto/ADF4001_init.v
new file mode 100644
index 00000000..71a35d75
--- /dev/null
+++ b/hdl/projects/pluto/ADF4001_init.v
@@ -0,0 +1,116 @@
+module ADF4001_init#
+(
+    parameter SPI_CLK_FREQ_MHZ = 5 
+)(
+//system clock and reset
+	input 				clk,
+	input 				rst_n,
+	
+//ADF4001 interface
+	output				SPI_LE,
+	output				SPI_SCLK,
+	output				SPI_MOSI,
+//status	
+	output 	reg		    init_done
+);
+
+//SPI driver
+wire 			spi_wr_start;
+wire 			spi_wr_done;
+reg [23:0] 	    spi_wr_data;
+reg 			spi_wr_en;
+
+ADF4001_spi_drive ADF4001_spi_drive_u(
+    .clk				(clk),
+    .rst_n				(rst_n),
+	
+    .wr_start			(spi_wr_start),
+    .wr_done			(spi_wr_done),
+
+    .wr_en				(spi_wr_en),
+    .wr_data			(spi_wr_data),
+
+    .spi_clk			(SPI_SCLK),
+    .spi_csn			(SPI_LE),
+    .spi_sdo			(SPI_MOSI)
+);
+
+reg	   [ 1:0]	reset_index;
+reg	   [ 7:0]	index;          
+reg	   [ 2:0]	state;
+reg    [31:0] 	delay_cnt;
+
+    
+always @ (posedge clk or negedge rst_n)begin
+    if(!rst_n) begin 
+        index       <= 0;       //reset index
+        init_done   <= 0;       //clear init-done flag
+        state       <= 0;       //reset state machine
+        delay_cnt   <= 0;       //delay counter
+        spi_wr_en   <= 0;       //clear SPI write enable
+        reset_index <= 0;
+    end
+    else 
+        case (state)    
+            3'd0    :   begin 
+                            spi_wr_data <= ADF4001_lut(index);
+                            spi_wr_en   <= 1'b0;	
+                            state 		<= 3'd1;
+            end  
+            
+            3'd1    :   begin 
+                            spi_wr_en   <= 1'b1;	
+                            state 		<= 3'd2;
+                        end  
+
+            3'd2    :   begin
+                            if(spi_wr_start) begin 
+                                state <= 3'd3;
+                                spi_wr_en   <= 1'b0;
+                            end
+                        end
+            3'd3    :   begin
+                            if(spi_wr_done) begin 
+                                state <= 3'd4;
+                            end
+                        end       
+            3'd4    :   begin 
+                            if(delay_cnt <= SPI_CLK_FREQ_MHZ * 2000)   //200Us
+                                delay_cnt <= delay_cnt + 1;
+                            else begin
+                                delay_cnt <= 0;   
+                                if(index == 8'd3) begin
+                                state <= 3'd5;
+                                end
+                                else begin
+                                    state <= 3'd0;
+                                    index <= index + 8'd1;
+                                end
+                            end
+                        end                        
+            3'd5    :   begin 
+                            state <= state;
+                            init_done <= 1'b1;
+                        end
+                        
+            default :   state <= 3'd0;
+            
+        endcase
+end
+	
+
+function [23:0] ADF4001_lut;
+    input [7:0] index;              //input index
+    reg [23:0] ADF4001_lut_d;       //intermediate value
+    begin
+        case(index)
+            8'd0:  ADF4001_lut_d = 24'h1F_8093;		
+            8'd1:  ADF4001_lut_d = 24'h1F_8092;	 			
+            8'd2:  ADF4001_lut_d = 24'h00_0004;                                          
+            8'd3:  ADF4001_lut_d = 24'h00_0401;	
+        endcase   
+        ADF4001_lut = ADF4001_lut_d;            //output the current value
+    end   
+endfunction   
+     
+endmodule
diff --git a/hdl/projects/pluto/ADF4001_spi_drive.v b/hdl/projects/pluto/ADF4001_spi_drive.v
new file mode 100644
index 00000000..4a77bfde
--- /dev/null
+++ b/hdl/projects/pluto/ADF4001_spi_drive.v
@@ -0,0 +1,87 @@
+module ADF4001_spi_drive(
+//system clock and reset
+    input 				clk,
+    input				rst_n,
+	
+//status
+    input 				wr_en,          //write enable, active high
+    input 		[23:0]  wr_data,        //write data
+    output 	reg 		wr_done,        //write done, active high
+    output 	reg 		wr_start,       //write start output
+	
+//SPI interface
+    output	reg 		spi_clk,
+    output	reg		    spi_csn,
+    output	 			spi_sdo
+);
+
+reg	   [4:0]   bit_cnt;	            //number of bits sent
+reg	   [23:0]  command;
+reg	   [2:0]   state;
+//SPI state    
+localparam     IDLE			= 0,            //idle
+			   START		= 1,            //start: load the command register
+			   TR			= 2,            //rising edge
+			   TR_0			= 3,            //falling edge
+			   DONE			= 4;
+
+//SPI write
+assign spi_sdo = command[23];
+always @ (posedge clk or negedge rst_n)
+begin
+    if(!rst_n) begin
+        state       <= IDLE;
+        spi_csn     <= 0;           
+        bit_cnt     <= 0;
+        wr_done 	<= 0;
+        spi_clk     <= 0;           //SPI idle state
+    end
+    else 
+        case (state)
+            IDLE   :   if (wr_en)                       
+                            begin
+                                state   <= START;
+                                bit_cnt <= 5'd0;	
+                                wr_done <= 1'b0;
+                                spi_clk <= 0;
+                                spi_csn <= 0;
+                            end 
+
+            START :     begin
+                                state   <= TR;
+                                wr_start<= 1'b1;
+                                command <= wr_data;//{1'b0,wr_addr,wr_data};
+                                spi_csn <= 1'b0;
+                        end
+            TR      :   if (bit_cnt <= 5'd23) 
+                            begin
+                                bit_cnt <= bit_cnt + 5'd1;
+                                spi_clk <= 1;
+                                state   <= TR_0;
+                            end
+                        else 
+                            begin
+                                spi_csn <= 1'b0;
+                                bit_cnt <= 5'd0;
+                                spi_clk <= 0;
+                                state   <= DONE;
+                            end
+            
+            TR_0    :   begin
+                            spi_clk <= 0;
+                            command <= command << 1;
+                            state   <= TR;
+                        end
+
+            DONE    :   begin 
+                            wr_done  <= 1'b1;
+                            wr_start <= 1'b0;
+                            spi_csn  <= 1'b1;
+                            state <= IDLE;
+                        end
+            
+            default :   state <= IDLE;
+        endcase
+end
+       
+endmodule
\ No newline at end of file
