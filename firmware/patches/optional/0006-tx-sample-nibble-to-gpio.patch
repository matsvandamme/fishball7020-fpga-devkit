diff --git a/hdl/projects/pluto/system_bd.tcl b/hdl/projects/pluto/system_bd.tcl
index 8eeff72ab..bbe8181ca 100755
--- a/hdl/projects/pluto/system_bd.tcl
+++ b/hdl/projects/pluto/system_bd.tcl
@@ -17,9 +17,17 @@ create_bd_port -dir I spi0_sdo_i
 create_bd_port -dir O spi0_sdo_o
 create_bd_port -dir I spi0_sdi_i
 
-create_bd_port -dir I -from 17 -to 0 gpio_i
-create_bd_port -dir O -from 17 -to 0 gpio_o
-create_bd_port -dir O -from 17 -to 0 gpio_t
+# 18 EMIO GPIO in the stock design; 22 here. The extra four (bits 21:18) are
+# the header pins that tx_gpio_bitmap hands back to Linux whenever the
+# bit-map flag is clear, so they stay usable as ordinary GPIO.
+create_bd_port -dir I -from 21 -to 0 gpio_i
+create_bd_port -dir O -from 21 -to 0 gpio_o
+create_bd_port -dir O -from 21 -to 0 gpio_t
+
+# The four header pins themselves, driven either by EMIO GPIO or by the low
+# nibble of the transmit sample. See tx_gpio_bitmap.v.
+create_bd_port -dir O -from 3 -to 0 sample_gpio_o
+create_bd_port -dir O -from 3 -to 0 sample_gpio_t
 
 create_bd_port -dir O spi_csn_o
 create_bd_port -dir I spi_csn_i
@@ -53,7 +61,7 @@ ad_ip_parameter sys_ps7 CONFIG.PCW_FPGA0_PERIPHERAL_FREQMHZ 100.0
 ad_ip_parameter sys_ps7 CONFIG.PCW_FPGA1_PERIPHERAL_FREQMHZ 200.0
 
 ad_ip_parameter sys_ps7 CONFIG.PCW_GPIO_EMIO_GPIO_ENABLE 1
-ad_ip_parameter sys_ps7 CONFIG.PCW_GPIO_EMIO_GPIO_IO 18
+ad_ip_parameter sys_ps7 CONFIG.PCW_GPIO_EMIO_GPIO_IO 22
 ad_ip_parameter sys_ps7 CONFIG.PCW_SPI1_PERIPHERAL_ENABLE 0
 ad_ip_parameter sys_ps7 CONFIG.PCW_I2C0_PERIPHERAL_ENABLE 0
 ad_ip_parameter sys_ps7 CONFIG.PCW_SD0_PERIPHERAL_ENABLE 1
@@ -221,6 +229,49 @@ ad_add_interpolation_filter "tx_fir_interpolator" 8 2 1 {61.44} {7.68} \
 ad_ip_instance xlslice interp_slice
 ad_ip_instance util_upack2 tx_upack
 
+# TX sample nibble -> header GPIO.
+#
+# The AD9361's DAC is 12 bits and takes dma_data[15:4]; dma_data[3:0] are
+# discarded inside the FPGA. tx_gpio_bitmap puts those four otherwise-wasted
+# bits on four header pins, in lockstep with the sample that carried them, so
+# they can act as a master clock / frame clock / sync line for external
+# receivers. Enabled by bit 1 of the DAC core's GP_CONTROL register
+# (up_dac_gpio_out, AXI offset 0xBC); bit 0 is already the interpolator
+# bypass above.
+#
+# add_files here rather than via adi_project_files in system_project.tcl:
+# this file is sourced from inside adi_project_create, which runs first, so
+# the module is not in the fileset yet.
+add_files -norecurse $ad_hdl_dir/projects/pluto/tx_gpio_bitmap.v
+create_bd_cell -type module -reference tx_gpio_bitmap tx_bitmap
+
+# bit 1 of up_dac_gpio_out = the bit-map enable flag
+ad_ip_instance xlslice bitmap_sel [list \
+  DIN_WIDTH 32 DIN_FROM 1 DIN_TO 1 DOUT_WIDTH 1]
+
+# the low nibble of the RAW DMA sample, before the interpolator - a FIR mixes
+# neighbouring samples together, so the nibble downstream of it would be
+# filter output rather than the pattern the user authored
+ad_ip_instance xlslice nibble_slice [list \
+  DIN_WIDTH 16 DIN_FROM 3 DIN_TO 0 DOUT_WIDTH 4]
+
+# bits 21:18 of the EMIO GPIO, which own the pins when the flag is clear
+ad_ip_instance xlslice gpio_bitmap_o [list \
+  DIN_WIDTH 22 DIN_FROM 21 DIN_TO 18 DOUT_WIDTH 4]
+ad_ip_instance xlslice gpio_bitmap_t [list \
+  DIN_WIDTH 22 DIN_FROM 21 DIN_TO 18 DOUT_WIDTH 4]
+
+# "fifo_rd_data just changed", which is what the nibble has to be captured on.
+# util_upack2 registers fifo_rd_data and then raises exactly one of
+# fifo_rd_valid / fifo_rd_underflow on the cycle the new word is standing at
+# its output - valid for a real sample, underflow for the zeros it substitutes
+# when the DMA has starved. OR-ing them means the pins carry the low nibble of
+# whatever the DAC is being given, including those zeros, with no exceptions to
+# write down.
+ad_ip_instance util_vector_logic bitmap_valid_or [list \
+  C_OPERATION {or} \
+  C_SIZE 1]
+
 ad_ip_instance axi_dmac axi_ad9361_adc_dma
 ad_ip_parameter axi_ad9361_adc_dma CONFIG.DMA_TYPE_SRC 2
 ad_ip_parameter axi_ad9361_adc_dma CONFIG.DMA_TYPE_DEST 0
@@ -323,6 +374,36 @@ ad_connect  tx_upack/fifo_rd_underflow axi_ad9361/dac_dunf
 ad_connect axi_ad9361/up_dac_gpio_out interp_slice/Din
 ad_connect  tx_fir_interpolator/active interp_slice/Dout
 
+# TX sample nibble -> header GPIO. fifo_rd_data_0 is channel-0 I straight out
+# of the unpacker; fifo_rd_data_1 is Q, the hook for a future I+Q widening.
+#
+# The strobe is NOT fifo_rd_en (logic_or/Res). fifo_rd_en is the REQUEST for a
+# sample; util_upack2 registers fifo_rd_data, so the requested word only
+# reaches the output on the following clock. Capturing on fifo_rd_en would
+# latch the previous sample, one behind the DAC forever. fifo_rd_valid /
+# fifo_rd_underflow are the registered pair that go high with the data, which
+# is why they are OR-ed together above.
+#
+# Capturing on a per-sample strobe at all, rather than on l_clk, is the other
+# half of this: in 2R2T mode a sample arrives only every second l_clk, and
+# capturing on the clock would silently double the rate of every authored
+# pattern.
+ad_connect axi_ad9361/l_clk tx_bitmap/clk
+ad_connect axi_ad9361/rst tx_bitmap/rst
+ad_connect tx_upack/fifo_rd_data_0 nibble_slice/Din
+ad_connect nibble_slice/Dout tx_bitmap/sample
+ad_connect tx_upack/fifo_rd_valid bitmap_valid_or/Op1
+ad_connect tx_upack/fifo_rd_underflow bitmap_valid_or/Op2
+ad_connect bitmap_valid_or/Res tx_bitmap/sample_valid
+ad_connect axi_ad9361/up_dac_gpio_out bitmap_sel/Din
+ad_connect bitmap_sel/Dout tx_bitmap/flag
+ad_connect sys_ps7/GPIO_O gpio_bitmap_o/Din
+ad_connect sys_ps7/GPIO_T gpio_bitmap_t/Din
+ad_connect gpio_bitmap_o/Dout tx_bitmap/gpio_o_in
+ad_connect gpio_bitmap_t/Dout tx_bitmap/gpio_t_in
+ad_connect tx_bitmap/pin_o sample_gpio_o
+ad_connect tx_bitmap/pin_t sample_gpio_t
+
 ad_connect  axi_ad9361/l_clk axi_ad9361_adc_dma/fifo_wr_clk
 ad_connect  axi_ad9361/l_clk axi_ad9361_dac_dma/m_axis_aclk
 ad_connect  cpack/fifo_wr_overflow axi_ad9361/adc_dovf
