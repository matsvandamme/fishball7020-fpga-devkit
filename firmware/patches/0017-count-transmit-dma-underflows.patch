+/*
+ * Called once per submitted block, from the buffer stream. Read-to-clear, so
+ * each event is counted exactly once.
+ */
+void cf_axi_dds_dma_stat_poll(struct cf_axi_dds_state *st)
+{
+	u32 stat = dds_read(st, ADI_REG_VDMA_STATUS);
+
+	if (!(stat & (ADI_VDMA_UNF | ADI_VDMA_OVF)))
+		return;
+
+	if (stat & ADI_VDMA_UNF)
+		st->tx_underflows++;
+	if (stat & ADI_VDMA_OVF)
+		st->tx_overflows++;
+
+	dds_write(st, ADI_REG_VDMA_STATUS, stat & (ADI_VDMA_UNF | ADI_VDMA_OVF));
+}
+EXPORT_SYMBOL_GPL(cf_axi_dds_dma_stat_poll);
+
+static ssize_t axidds_dma_stat_show(struct device *dev,
+				    struct device_attribute *attr, char *buf)
+{
+	struct iio_dev_attr *this = to_iio_dev_attr(attr);
+	struct cf_axi_dds_state *st = iio_priv(dev_to_iio_dev(dev));
+
+	return sprintf(buf, "%llu\n",
+		       this->address ? st->tx_overflows : st->tx_underflows);
+}
+
+static ssize_t axidds_dma_stat_store(struct device *dev,
+				     struct device_attribute *attr,
+				     const char *buf, size_t len)
+{
+	struct iio_dev_attr *this = to_iio_dev_attr(attr);
+	struct cf_axi_dds_state *st = iio_priv(dev_to_iio_dev(dev));
+
+	/* Any write zeroes it: the useful question is almost always
+	 * "how many since I started", not "since boot". */
+	if (this->address)
+		st->tx_overflows = 0;
+	else
+		st->tx_underflows = 0;
+
+	return len;
+}
+
+static IIO_DEVICE_ATTR(tx_dma_underflow_count, S_IRUGO | S_IWUSR,
+		       axidds_dma_stat_show, axidds_dma_stat_store, 0);
+
+static IIO_DEVICE_ATTR(tx_dma_overflow_count, S_IRUGO | S_IWUSR,
+		       axidds_dma_stat_show, axidds_dma_stat_store, 1);
+
 static ssize_t axidds_tx_cyclic_show(struct device *dev,
 				     struct device_attribute *attr, char *buf)
 {
