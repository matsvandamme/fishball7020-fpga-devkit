 EXPORT_SYMBOL_GPL(cf_axi_dds_tx_rf_mute);
 
+/*
+ * The transmitter must go quiet when the DAC stops being fed, not merely when
+ * software says it has finished.
+ *
+ * postdisable is an event, and events can be missed. Measured on this board
+ * (tools/IDLE-CASES.md, case B): kill -9 a local process feeding a TX buffer
+ * and buffer/enable stays 1, the IIO core never runs postdisable, the mute
+ * never fires, and the port sits 12.6 dB hotter than muted with no process
+ * alive and nobody having asked for anything. Case C - a client that stalls
+ * mid-stream without dying - was never covered at all.
+ *
+ * "No block has arrived for N milliseconds" is a state rather than an event,
+ * and a state cannot be missed. One timer closes both cases.
+ *
+ * This runs from a workqueue, not a timer, because muting talks to the AD9361
+ * over SPI and that sleeps.
+ */
+static void cf_axi_dds_tx_starve_fn(struct work_struct *work)
+{
+	struct cf_axi_dds_state *st = container_of(to_delayed_work(work),
+						   struct cf_axi_dds_state,
+						   tx_starve_work);
+
+	if (st->tx_muted)
+		return;
+
+	dev_warn(&st->indio_dev->dev,
+		 "%s for %u ms - muting the transmitter\n",
+		 st->tx_cyclic ? "cyclic transmit has run unattended"
+			       : "no transmit data",
+		 st->tx_cyclic ? st->tx_cyclic_ms : st->tx_starve_ms);
+
+	cf_axi_dds_tx_rf_mute(st, true);
+	cf_axi_dds_datasel(st, -1, DATA_SEL_DDS);
+}
+
+/*
+ * Called for every submitted block. cyclic streams are deliberately NOT armed:
+ * the hardware repeats one block forever, so silence on the submission path is
+ * correct behaviour rather than a fault.
+ */
+void cf_axi_dds_tx_starve_arm(struct cf_axi_dds_state *st, bool cyclic)
+{
+	unsigned int ms = cyclic ? st->tx_cyclic_ms : st->tx_starve_ms;
+
+	st->tx_cyclic = cyclic;
+
+	if (!ms) {
+		cancel_delayed_work(&st->tx_starve_work);
+		return;
+	}
+
+	mod_delayed_work(system_wq, &st->tx_starve_work, msecs_to_jiffies(ms));
+}
+EXPORT_SYMBOL_GPL(cf_axi_dds_tx_starve_arm);
+
+void cf_axi_dds_tx_starve_cancel(struct cf_axi_dds_state *st)
+{
+	cancel_delayed_work_sync(&st->tx_starve_work);
+	st->tx_cyclic = false;
+}
+EXPORT_SYMBOL_GPL(cf_axi_dds_tx_starve_cancel);
+
+void cf_axi_dds_tx_starve_init(struct cf_axi_dds_state *st)
+{
+	INIT_DELAYED_WORK(&st->tx_starve_work, cf_axi_dds_tx_starve_fn);
+	st->tx_starve_ms = CF_AXI_DDS_TX_STARVE_MS_DEFAULT;
+	st->tx_cyclic_ms = 0;		/* off: cyclic is meant to outlive you */
+}
+EXPORT_SYMBOL_GPL(cf_axi_dds_tx_starve_init);
+
 static int cf_axi_dds_update_scan_mode(struct iio_dev *indio_dev,
 	const unsigned long *scan_mask)
 {
