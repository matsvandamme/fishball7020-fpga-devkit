+	/*
+	 * A very short timeout would mute a healthy stream between blocks over
+	 * a slow link; this board's own network path already delivers in bursts
+	 * with gaps. Refuse the values that would do that rather than let
+	 * someone discover it as a mysterious dropout.
+	 */
+	if (ms && ms < CF_AXI_DDS_TX_STARVE_MS_MIN)
+		return -EINVAL;
+
+	st->tx_starve_ms = ms;
+
+	if (!ms)
+		cancel_delayed_work_sync(&st->tx_starve_work);
+
+	return len;
+}
