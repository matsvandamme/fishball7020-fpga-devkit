  id: variable_qtgui_check_box
  parameters:
    label: '''zero (latch this phase as the reference)'''
    type: bool
    value: 'False'
    'true': 'True'
    'false': 'False'
    gui_hint: 7,0,1,2
    comment: 'Latches on the RISING EDGE only, or it

      would re-zero forever.'
  states:
