    type: bool
    value: 'False'
    'true': 'True'
    'false': 'False'
    gui_hint: 7,0,1,2
    comment: 'Latches the CURRENT phase as zero, on the rising edge

      only. Holding it ticked would re-zero forever and the

      reading would sit at zero whatever the antennas did.'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 704
