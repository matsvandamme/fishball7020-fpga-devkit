    filter: ''
    fpass: '0'
    fstop: '0'
    bandwidth: int(samp_rate)
    len_tag_key: packet_len
    comment: 'BOTH receivers, one LO, one sample clock. That shared

      oscillator is the whole reason this example exists.

      The LO sits lo_off_hz below the frequency you asked for.'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 176
    - 460
    rotation: 0
    state: enabled
