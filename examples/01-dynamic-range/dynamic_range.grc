    bus_source: false
    bus_structure: null
    coordinate:
    - 256
    - 12
    rotation: 0
    state: enabled
- name: buf
  id: variable
  parameters:
    value: '262144'
    comment: 'libiio buffer, in samples. 262144 is 1 MB - about 52 ms at the

      default rate, which keeps the controls feeling immediate. Raise it

      to 1048576+ before selecting a high sample rate; see the note.'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 352
    - 12
    rotation: 0
    state: enabled
- name: center_hz
