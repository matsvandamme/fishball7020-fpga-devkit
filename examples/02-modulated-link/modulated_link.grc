- name: reassert_atten
  id: snippet
  parameters:
    section: main_after_start
    priority: '0'
    code: "import time\n\n# Let the first buffer actually open before touching the attenuator;\
      \ writing\n# into the gap is the thing this is here to avoid.\ntime.sleep(0.5)\n\n#\
      \ Goes through the generated setter, so it re-evaluates `tx_atten if arm else\n# 89.75`\
      \ with whatever the GUI currently says.\nself.set_tx_atten(self.tx_atten)\n\nprint('[02]\
      \ armed=%s, attenuation re-asserted as %.2f dB after the stream '\n      'opened.' %\
      \ (self.arm, self.tx_atten if self.arm else 89.75))\nprint('[02] the number beside ARM\
      \ is read back out of the chip - if it '\n      'disagrees with the slider, believe\
      \ the chip.')\n"
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1200
    - 320
    rotation: 0
    state: enabled
