#!/bin/bash
# One entry point, so you do not have to remember which script lives where or
# which directory it wants to run from. Run it from anywhere.
#
# ---- Two firmware targets ---------------------------------------------------
#
#   --target modern    (the default) Linux 6.12 LTS and a Debian root.
#                      firmware-modern/. No Vivado path at all: it ALWAYS takes
#                      an --xsa, and builds BOOT.bin from the same FSBL and
#                      U-Boot source as factory.
#                      Needs an ARM Linux cross-compiler - or ./devkit container,
#                      which has one. Setup fetches ~0.6 GB.
#   --target factory   The vendor tree: its 5.15 kernel and a Buildroot ramdisk,
#                      and the FPGA built with Vivado or taken from an --xsa.
#                      firmware/. Needs: Vivado, OR an --xsa. Setup fetches
#                      ~6.8 GB. Changing the FPGA itself happens here.
#
#   Takes --target:  doctor  setup  build  verify  flash  write-card  status
#   Everything else is the same board and the same tools either way.
#   DEVKIT_TARGET=factory in your environment makes factory the default.
#
# ---- Before you build -------------------------------------------------------
#
#     ./devkit doctor      Can this machine build? Checks the compilers, host
#                          packages, disk and the sources; on factory also
#                          Vivado, the patch stamp and the board. In about a
#                          second. Every check is a failure that once cost
#                          somebody an hour. Run it before the hour, not during.
#     ./devkit setup       Fetch the kernel and boot-loader source, and apply
#                          this repo's patches (factory: into firmware/src/).
#                          Safe to re-run; it stamps what it applied. Needed
#                          once, and after every new patch.
#
# ---- Building ---------------------------------------------------------------
#
#     ./devkit sim         Simulate the custom HDL against a golden model. About
#                          a second, needs only iverilog, and catches the logic
#                          errors a 70-minute synthesis cannot. Do this first.
#     ./devkit build --xsa FILE
#                          BOOT.bin, uImage, devicetree.dtb and uEnv.txt for the
#                          modern target, into firmware-modern/output/. --xsa is
#                          the FPGA design to build around, and is required:
#                          "$(./firmware-modern/fetch-pinned-xsa.sh)" fetches the
#                          one a factory release shipped.         (~2 min after the
#                          first build; the first takes the kernel)
#       --boot-only        BOOT.bin and uEnv.txt; skip the kernel.
#       --all              The boot files, then the Debian root as well.
#     ./devkit build --rootfs-only
#                          The Debian root filesystem, rootfs.tar, that write-card
#                          puts on the card. No --xsa. Needs podman or docker and
#                          armhf emulation; it registers the emulation itself where
#                          it can. Run it on the host.              (~10 min)
#     ./devkit container build --xsa FILE
#                          The boot files, on a machine with no ARM Linux compiler.
#     ./devkit build --target factory
#                          The factory target, everything: FPGA, boot loader,
#                          kernel, root filesystem, packaging.        (45-90 min)
#       --hdl-only         Just the FPGA side, reusing the existing kernel,
#                          u-boot and rootfs.                            (~20 min)
#       --xsa FILE         Do NOT run Vivado. Use a hardware platform that was
#                          already built - your own from a previous build, or the
#                          system_top.xsa attached to a FACTORY release, v1.6 or
#                          later. A release's XSA is THAT release's FPGA design:
#                          none published so far matches a current from-source
#                          build. Needs NOTHING from AMD: the FSBL builds from
#                          embeddedsw and bootgen from AMD's own source. Vivado
#                          does not even have to be installed.
#                          -> docs/building-without-vivado.md
#     ./devkit verify      Is the build sane? Five files present, bitstream
#                          compressed, timing met, and what is in the design.
#       --board            Also compare the card against what you built. This is
#                          the only thing that proves the board runs your build.
#
# ---- Getting it onto the board ----------------------------------------------
#
#     ./devkit flash       Copy the build onto the running board over the network,
#                          with a backup and an md5 check before anything is
#                          swapped in. Never use DFU on this board.
#       --boot-only        BOOT.bin only - an HDL or bitstream change.
#       --kernel-only      uImage only - a driver or kernel change. Fast, and
#                          recoverable over the network if it goes wrong.
#       --dtb-only         devicetree.dtb only - a device-tree patch.
#                          The Debian root cannot be swapped over the network:
#                          build it, then write a card:
#                              ./devkit build --rootfs-only
#                              sudo ./devkit write-card /dev/sdX
#       --target factory   Flash the factory build instead, which also takes:
#         --all            all five SD-card files (a release)
#         --rootfs-only    uramdisk.image.gz only
#     sudo ./devkit write-card /dev/sdX
#                          A whole modern card from a card reader: BOOT.bin and the
#                          kernel on p1, the Debian root on p2. DESTROYS the card;
#                          refuses any disk that is not removable. Needs sudo.
#       --dry-run          Every check, and the plan, with nothing written.
#       --image NEW_FILE   Write into a new image file instead of a disk.
#
# ---- Once it is running -----------------------------------------------------
#
#     ./devkit status      Where am I? What is built, and what is the board
#                          running right now.
#     ./devkit selftest    Is the board damaged? Measures supply rails, die
#                          temperatures, the AD9361 interface eye and the
#                          receiver, and says. Never transmits.
#       --ssh              Also list what the persistent /mnt/jffs2 partition
#                          starts at boot - scripts there survive reflashing and
#                          can move settings underneath your application.
#       --loopback --pad N This one DOES transmit. Needs TX wired to RX through
#                          at least 20 dB, or you will destroy the receiver - and
#                          needs an affirmation that the port is terminated:
#                              ./devkit tx-guard affirm 0
#                          --pad is not that. A number on a command line says what
#                          you believed was in the path; the affirmation says you
#                          have looked. Refused (exit 1) without one, having raised
#                          nothing. The board cannot tell you: no coupler, no
#                          detector on transmit.
#     ./devkit gpio-check  Verify the sample-locked GPIO outputs on hardware. No
#                          scope and no antenna needed.
#     ./devkit net         How the board gets its address; switch DHCP/static,
#                          set its hostname, or just find it.
#     ./devkit ssh-key     Stop typing the password. Makes a key used only for
#                          this board, installs it, adds a `Host fishball`
#                          shorthand, and proves it works with BatchMode so a
#                          password cannot have been involved. Idempotent.
#       --check            Is it already working?
#       --show             Print the public key.
#     ./devkit tx-guard <command>
#                          The transmit gate, run on the board. Per CHANNEL,
#                          because TX1A and TX2A are two separate SMA ports and
#                          one may have a pad on it while the other has an
#                          antenna. Affirmations live in the board's /tmp, so a
#                          reboot withdraws them.
#       affirm <0|1>       record that THAT port is terminated
#       revoke [0|1|both]  withdraw, and force maximum attenuation
#       status             affirmations, attenuation, buffer state
#       check <0|1>        is that channel affirmed? exit 0 yes, 3 no. For a
#                          tool that writes its own attenuation and wants to ask
#                          the gate once instead of routing every write through it
#       set-gain <0|1> <dB>  write attenuation on one channel; refused (exit 3)
#                          unless that channel is affirmed
#       reap               disable a TX buffer left enabled with no owner
#     ./devkit matlab      Is MATLAB ready to use this board? Checks the
#                          toolboxes, the ADALM-Pluto support package and the
#                          board itself. No addpath to remember.
#       shell              Interactive MATLAB with the fishball package and the
#                          examples already on the path.
#       hello              Run example 01 against the board.
#       run <expr>         Evaluate one expression with the path set.
#     ./devkit clock       What the 40 MHz reference correction is set to, and
#                          measure it against a source you trust. EXT_CLK cannot
#                          discipline this radio - that U.FL goes to the fabric,
#                          not the AD9361 - but xo_correction gets you accuracy
#                          without soldering.
#       measure --ref HZ   Measure. Needs a disciplined source on an RX port,
#                          through at least 20 dB of pad.
#       --apply            Write the measured value.
#     ./devkit completion  Tab completion for all of the above. Either
#                            source <(./devkit completion)   -> this shell
#                            ./devkit completion install     -> every shell
#     ./devkit uboot-contract
#                          What the bootloader must still do after you replace
#                          it: the QSPI environment readable, ethaddr pinning the
#                          MAC, the gadget's derived name, uEnv.txt still being
#                          imported. Run it with --save BEFORE touching U-Boot and
#                          plain afterwards; it diffs against the recorded
#                          baseline. A boot test covers none of this.
#       --save             Record today's answers as the baseline.
#     ./devkit temps       Both die temperatures against their ratings, LIVE -
#                          refreshing in place with the min, max and direction
#                          of travel since you started, until Ctrl-C. The Zynq
#                          via its XADC, the AD9361 via its own sensor; those
#                          are the only two sensors on the board, so there is
#                          nothing on the amplifiers, the DDR or the regulators.
#                          Piping it turns live off by itself.
#       --once             A single reading instead.
#       --interval S       Seconds between readings (default 2).
#       --json             Machine-readable, one reading.
#     ./devkit loopback    The AD9361's internal digital loopback: transmit
#                          samples are fed to the receiver INSIDE the chip, so a
#                          whole transmit-and-receive flowgraph can be exercised
#                          with nothing radiated and no licence question. With no
#                          argument it just reports the current state.
#       on                 Engage it. The antennas go deaf while it is on, so
#                          the tool says so loudly - a board left in loopback
#                          looks broken for no visible reason.
#       off                Put it back. Cleared by a reboot too.
#       --json             Machine-readable.
#                          It bypasses everything analogue, so a clean result
#                          proves the DSP and proves nothing about the mixers,
#                          the amplifier or the antennas. Used by
#                          examples/02-modulated-link.
#     ./devkit adsb        Aircraft, live: receives ADS-B on 1090 MHz and shows
#                          one row per aircraft (callsign, altitude, speed,
#                          position) above a log of every message whose checksum
#                          holds. RECEIVE ONLY - it never opens a transmit
#                          buffer. Needs a 1090 MHz antenna. The window needs
#                          PyQt6, which uv fetches on first use (~100 MB).
#       --channel 2        The antenna is on RX2A (default RX1A).
#       --gain DB|agc      Receive gain (default 25; above ~35 it can overload).
#       --text             In the terminal instead; needs only numpy.
#       --record NAME      Also save the samples, as SigMF.
#       --replay FILE      Play a recording back. No board needed.
#                          -> docs/adsb.md
#     ./devkit automation  The automation server: a gRPC service on the board
#                          (port 7020) that scripts on your PC call to read the
#                          radio's state, set it, measure the reference clock and
#                          record gap-free captures. It never transmits.
#       install            Put it on the board as a service (Debian root).
#       status             The board, the radio, the clock, who holds the buffers.
#       clock --measure    Time the reference against the board's own crystal.
#       capture NAME --samples N [--channels 1,2]   Record, fetch as SigMF.
#       smoke              An end-to-end check; receive only.
#       mute               Both transmitters to the floor, read back.
#       test               Its unit tests, against a fake board. No board needed.
#                          -> docs/automation.md
#
# ---- If your host OS is too new for Vivado ----------------------------------
#
#     ./devkit container   Run any of the above inside the pinned Vivado 2022.2
#                          environment, so the host OS is free to move.
#     ./devkit container install <bin>
#                          Install Vivado itself, for a host too new to run its
#                          own installer.
#
# ---- The usual runs ---------------------------------------------------------
#
#     ./devkit doctor && ./devkit setup \
#       && ./devkit build --all --xsa "$(./firmware-modern/fetch-pinned-xsa.sh)" \
#       && sudo ./devkit write-card /dev/sdX                  # from nothing
#     ./devkit build --xsa FILE && ./devkit flash --kernel-only  # a kernel change
#     ./devkit sim && ./devkit build --target factory --hdl-only \
#       && ./devkit verify --target factory \
#       && ./devkit flash --target factory --boot-only        # an HDL change
#     ./devkit selftest --ssh                                 # "is it broken?"
#
# ---- Tab completion ---------------------------------------------------------
#
#     source <(./devkit completion)      # this shell, one command, no files
#     ./devkit completion install        # every new shell, from then on
#
# Completes subcommands, then that subcommand's own flags, so you do not have
# to remember that --dtb-only is on flash and not on build. --xsa completes
# .xsa files. zsh works too, after: autoload -U bashcompinit && bashcompinit
#
# Extra arguments pass straight through, so anything the underlying script
# accepts works here too. Each subcommand's own --help has the full list.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FW="$HERE/firmware"

usage_all() { sed -n '2,/^set -/p' "${BASH_SOURCE[0]}" | sed '$d' | sed 's/^# \{0,1\}//'; }

COMMANDS="doctor setup sim build verify flash write-card status selftest gpio-check net
          ssh-key tx-guard matlab clock completion uboot-contract temps loopback container adsb
          automation"

# One screen: what each command is for, and the runs people actually do. The
# full text above is `./devkit help --all`; one command's part of it is
# `./devkit help <command>`.
usage() {
    cat <<'USAGE'
./devkit <command> [options]       run it from anywhere

Before you build
  doctor          can this machine build? checks it in about a second
  setup           fetch the source and apply this repo's patches

Build and check
  build           build the firmware (modern: needs --xsa, the FPGA design)
  sim             simulate the custom HDL in a second, before a 20-minute build
  verify          is the build sane? --board: is the board running it?

Put it on the board
  flash           copy a build onto the running board, over the network
  write-card      write a whole SD card from a card reader

Once it runs
  status          what is built, and what the board is running
  selftest        is the board damaged? never transmits
  ssh-key         log in without typing the password
  net             the board's address: DHCP, static, hostname, or find it
  temps           live die temperatures
  adsb            aircraft overhead, live, from 1090 MHz ADS-B (receive only)
  automation      a server on the board for your measurement scripts (never transmits)
  tx-guard        the transmit gate: affirm a port is terminated first
  also: gpio-check  clock  loopback  matlab  uboot-contract  container  completion

Two firmware targets
  --target modern    Linux 6.12 + Debian; takes the FPGA from an .xsa file (the default)
  --target factory   Linux 5.15 + Buildroot; the FPGA itself, built with Vivado
  DEVKIT_TARGET=factory in your environment makes factory the default.

The usual runs
  ./devkit doctor && ./devkit setup                      # once
  ./devkit build --all --xsa "$(./firmware-modern/fetch-pinned-xsa.sh)"
  sudo ./devkit write-card /dev/sdX                      # a whole card
  ./devkit flash --kernel-only                           # a kernel change, over the network
  ./devkit selftest --ssh                                # "is it broken?"

  ./devkit help <command>    one command in detail
  ./devkit help --all        everything, with every option
  ./devkit --version         which devkit this is, and what is built
USAGE
}

# The part of the full help that describes one command: from each line that
# starts "./devkit <cmd>" at the command indent (4 spaces; deeper ones are
# examples inside another command) to the next command or section heading.
usage_for() {
    usage_all | awk -v c="$1" '
        /^ {4}(sudo )?\.\/devkit [a-z-]+/ {
            n = $0; sub(/^ {4}(sudo )?\.\/devkit /, "", n); sub(/[ \t].*/, "", n); on = (n == c) }
        /^---- / { on = 0 }
        on'
}

# "flsh" -> "flash". Prints nothing when nothing is close.
suggest() {
    python3 -c 'import difflib, sys
m = difflib.get_close_matches(sys.argv[1], sys.argv[2:], n=1, cutoff=0.6)
print(m[0] if m else "")' "$1" $COMMANDS 2>/dev/null || true
}

# Commands that need the board check that it answers BEFORE they run, so every
# one of them fails the same way, within a few seconds, with the same advice.
# Skipped for --help, and when an address is given on the command line (the
# tool checks that one itself). An ssh-only command accepts a modern board
# whose iiod is down (board_addr.py exit 3); an iiod command does not.
FOUND=""         # where need_board found the board
need_board() {   # <exit code on failure> <ssh|iiod> <the command's arguments...>
    local code="$1" kind="$2" a rc=0; shift 2
    for a in "$@"; do
        case "$a" in -h|--help|--uri|--uri=*|--host|--host=*|ip:*) return 0 ;; esac
    done
    FOUND="$(python3 "$HERE/tools/board_addr.py" --check --why)" || rc=$?
    if [ "$rc" -eq 0 ] || { [ "$rc" -eq 3 ] && [ "$kind" = ssh ]; }; then return 0; fi
    exit "$code"
}

# What the board is running, for status: over IIOD, so no password.
board_status() {
    echo "== board =="
    local out rc=0
    out="$(python3 "$HERE/tools/board_info.py" 2>/dev/null)" || rc=$?
    case "$rc" in
        0)  printf '%s\n' "$out" | sed 's/^/   /'
            if [ "$TARGET" = factory ]; then
                echo "   ./devkit verify --target factory --board checks the card holds exactly this build"
            else
                echo "   ./devkit verify --board checks the card holds exactly this build"
            fi ;;
        3)  printf '%s\n' "$out" | sed 's/^/   /'
            echo "   on the board: journalctl -b -u fishball-rf-quiesce -u iiod" ;;
        *)  echo "   not found (tried $(python3 "$HERE/tools/board_addr.py" --list | paste -sd, | sed 's/,/, /g'))" ;;
    esac
}

cmd="${1:-}"; shift || true

# Help and version first: they must work without touching a board or a tree.
case "$cmd" in
    ""|-h|--help)
        usage; exit 0 ;;
    help)
        case "${1:-}" in
            "")        usage ;;
            --all|-a)  usage_all ;;
            *)         exec "${BASH_SOURCE[0]}" "$1" --help ;;
        esac
        exit 0 ;;
    -V|--version|version)
        echo "devkit $(git -C "$HERE" describe --tags --always --dirty 2>/dev/null || echo '(not a git checkout)')"
        for _t in "factory:$HERE/firmware/output/BOOT.bin" "modern:$HERE/firmware-modern/output/BOOT.bin"; do
            _f="${_t#*:}"
            if [ -r "$_f" ]; then printf '  %-8s built %s\n' "${_t%%:*}" "$(date -r "$_f" '+%Y-%m-%d %H:%M')"
            else printf '  %-8s not built\n' "${_t%%:*}"; fi
        done
        exit 0 ;;
esac

# These wrap scripts whose own --help is missing or would DO something (setup
# would start cloning, tx-guard would log in to the board, container would
# build an image), so their help comes from the text at the top of this file.
case "$cmd" in
    setup|doctor|status|tx-guard|container)
        for _a in "$@"; do
            case "$_a" in -h|--help) usage_for "$cmd"; exit 0 ;; esac
        done ;;
esac

# --target factory|modern (#9). Parsed ONLY for the commands whose meaning
# differs per target, and stripped from their arguments. Everything else keeps
# it untouched - so `./devkit container build --target modern` hands it through
# to the ./devkit inside the container, which parses it there.
#
# Modern is the default; DEVKIT_TARGET=factory in your environment brings the
# old default back. A command line that relied on factory being the default and
# now reaches the modern target is refused with a message naming --target
# factory, rather than doing something else: the modern build demands --xsa
# and refuses --hdl-only, and the modern flash refuses --all and --rootfs-only.
TARGET="${DEVKIT_TARGET:-modern}"
case "$cmd" in
    setup|build|verify|flash|doctor|status|write-card)
        _rest=(); _take=0
        for a in "$@"; do
            if [ "$_take" -eq 1 ]; then TARGET="$a"; _take=0; continue; fi
            case "$a" in
                --target)   _take=1 ;;
                --target=*) TARGET="${a#--target=}" ;;
                *)          _rest+=("$a") ;;
            esac
        done
        [ "$_take" -eq 1 ] && { echo "ERROR: --target needs a value: factory or modern" >&2; exit 1; }
        case "$TARGET" in
            factory|modern) ;;
            *) echo "ERROR: unknown --target '$TARGET'${DEVKIT_TARGET:+ (DEVKIT_TARGET=$DEVKIT_TARGET?)}. It is modern (the default) or factory." >&2
               exit 1 ;;
        esac
        set -- ${_rest[@]+"${_rest[@]}"} ;;
esac
FWM="$HERE/firmware-modern"

case "$cmd" in
    doctor)
        # The modern target's doctor IS its build preflight: one list of what it
        # needs, so the two cannot disagree about whether this machine can build.
        if [ "$TARGET" = modern ]; then exec "$FWM/build_all.sh" --preflight-only "$@"; fi
        exec "$FW/scripts/doctor.sh" "$@" ;;
    setup)
        if [ "$TARGET" = modern ]; then exec "$FWM/setup.sh" "$@"; fi
        cd "$FW" && exec ./scripts/setup.sh "$@" ;;
    build)
        # build_all.sh runs from firmware/, so a RELATIVE --xsa path would be
        # resolved against firmware/ rather than against the directory you
        # typed it in. Make it absolute here, while we still know where that
        # was. Measured the wrong way round first: "--xsa local-test.xsa" from
        # the repo root went looking in firmware/local-test.xsa.
        args=()
        take_next=0
        for a in "$@"; do
            if [ "$take_next" -eq 1 ]; then
                case "$a" in /*) ;; *) a="$PWD/$a" ;; esac
                take_next=0
            elif [ "$a" = "--xsa" ]; then
                take_next=1
            else
                case "$a" in
                    --xsa=/*) ;;
                    --xsa=*)  a="--xsa=$PWD/${a#--xsa=}" ;;
                esac
            fi
            args+=("$a")
        done
        if [ "$TARGET" = modern ]; then exec "$FWM/build_all.sh" ${args[@]+"${args[@]}"}; fi
        cd "$FW" && exec ./scripts/build_all.sh ${args[@]+"${args[@]}"} ;;
    verify)
        if [ "$TARGET" = modern ]; then exec "$FWM/verify_output.sh" "$@"; fi
        cd "$FW" && exec ./scripts/verify_output.sh "$@" ;;
    sim)        cd "$FW" && exec ./sim/run_sim.sh "$@" ;;
    flash)
        if [ "$TARGET" = modern ]; then
            # The modern root is Debian on the card's second partition, not a
            # file on /boot, so it cannot be swapped over the network. Refuse
            # --all and --rootfs-only, and give the two commands that do it.
            for a in "$@"; do
                case "$a" in
                    --all|--rootfs-only)
                        echo "ERROR: flash cannot write the modern target's Debian root over the" >&2
                        echo "       network. Build it, then write a card from a card reader:" >&2
                        echo "           ./devkit build --rootfs-only" >&2
                        echo "           sudo ./devkit write-card /dev/sdX" >&2
                        echo "       Over the network: --boot-only, --kernel-only, --dtb-only." >&2
                        echo "       The factory firmware's five files: ./devkit flash --target factory $a" >&2
                        exit 1 ;;
                esac
            done
            FW_OUTPUT="$FWM/output" exec "$HERE/tools/flash.sh" "$@"
        fi
        exec "$HERE/tools/flash.sh" "$@" ;;
    write-card)
        if [ "$TARGET" != modern ]; then
            echo "ERROR: write-card is the modern target's: sudo ./devkit write-card /dev/sdX" >&2
            echo "       A factory card is one FAT32 partition holding the five files in" >&2
            echo "       firmware/output/ - copy them, or use ./devkit flash --target factory --all over the network." >&2
            exit 1
        fi
        exec "$FWM/debian/write-card.sh" "$@" ;;
    # No "cd" here, unlike setup/build/verify/sim: the script does not need one,
    # and changing directory made every relative file argument resolve against
    # tools/selftest/ instead of where you ran the command. "--json out.json"
    # from the repo root wrote into tools/selftest/, and
    # "--json firmware-modern/baseline/x.json" failed outright with
    # FileNotFoundError on a directory that plainly exists.
    selftest)   need_board 2 iiod "$@"; exec "$HERE/tools/selftest/sdr_selftest.py" "$@" ;;
    gpio-check) need_board 1 iiod "$@"; exec "$HERE/tools/tx-gpio-bitmap-check.py" "$@" ;;
    container)  exec "$HERE/tools/container/run.sh" "$@" ;;
    net)        # find looks for a hostname you may have changed: no pre-check.
                [ "${1:-}" = find ] || need_board 1 ssh "$@"
                exec "$HERE/tools/net.sh" "$@" ;;
    temps)      need_board 1 iiod "$@"; exec python3 "$HERE/tools/temps.py" "$@" ;;
    uboot-contract) need_board 1 ssh "$@"; exec "$HERE/tools/uboot-contract.sh" "$@" ;;
    loopback)   need_board 1 iiod "$@"; exec python3 "$HERE/tools/examples_loopback.py" "$@" ;;
    adsb)
        # A replay needs no board. The window needs PyQt6: use this Python's if
        # it has it, otherwise let uv fetch it (the script declares it, PEP 723).
        case " $* " in *" --replay"*) ;; *) need_board 1 iiod "$@" ;; esac
        for _a in "$@"; do
            case "$_a" in -h|--help|--text) exec python3 "$HERE/tools/adsb/adsb.py" "$@" ;; esac
        done
        if python3 -c 'import PyQt6.QtWidgets, numpy' 2>/dev/null; then
            exec python3 "$HERE/tools/adsb/adsb.py" "$@"
        fi
        command -v uv >/dev/null || {
            echo "ERROR: the window needs PyQt6. Either, in a venv: .venv/bin/pip install PyQt6 numpy" >&2
            echo "       or install uv (https://docs.astral.sh/uv/), which fetches it" >&2
            echo "       or: ./devkit adsb --text    (the terminal; needs only numpy)" >&2
            exit 1; }
        exec uv run --quiet --script "$HERE/tools/adsb/adsb.py" "$@" ;;
    matlab)     exec "$HERE/tools/matlab.sh" "$@" ;;
    ssh-key)
        case "${1:-}" in --show|--check|-h|--help) ;; *) need_board 1 ssh "$@" ;; esac
        exec "$HERE/tools/ssh-key.sh" "$@" ;;
    tx-guard)
        # tools/tx-guard.sh runs ON THE BOARD - it reads sysfs directly and keeps
        # its per-channel affirmations in the board's /tmp, which is tmpfs, so
        # they cannot outlive a reboot. Pushed fresh on every call rather than
        # installed, so there is never a stale copy answering for the current one.
        #
        # At the address the board was actually found at, not through the
        # `Host fishball` alias: that names fishball.local, which is not
        # announced over the USB link, so it failed on a board answering fine
        # at 192.168.2.1. The key ./devkit ssh-key made is used when it exists;
        # the board wants root either way.
        need_board 4 ssh "$@"
        _key="${FISHBALL_SSH_KEY:-$HOME/.ssh/fishball}"
        # No known_hosts, as in tools/flash.sh: every new card makes new host
        # keys, and a stale entry would read as "could not reach the board".
        _ssh=(ssh -o BatchMode=yes -o ConnectTimeout=8 -o LogLevel=ERROR
              -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null)
        [ -r "$_key" ] && _ssh+=(-i "$_key" -o IdentitiesOnly=yes)
        _tgt="root@${FOUND:-${BOARD:-192.168.2.1}}"
        "${_ssh[@]}" "$_tgt" 'cat > /tmp/tx-guard.sh' < "$HERE/tools/tx-guard.sh" \
            || { echo "could not reach the board to push tx-guard.sh" >&2; exit 4; }
        # exec, so the script's documented exit codes reach the caller:
        # 0 ok / 1 refused on validation / 3 no affirmation / 4 write failed /
        # 10 reaped a stale buffer / 11 found an owner.
        exec "${_ssh[@]}" "$_tgt" "sh /tmp/tx-guard.sh $*" ;;
    clock)      need_board 1 iiod "$@"; exec python3 "$HERE/tools/clock-cal.py" "$@" ;;
    automation) exec "$HERE/tools/automation/automation.sh" "$@" ;;
    completion)
        # No argument: print the script, so one command sets this shell up
        #     source <(./devkit completion)
        # "install": put it where bash-completion loads from by itself, so
        # new shells have it without anyone sourcing anything. A shell cannot
        # load completions from a directory it has never been told about, so
        # one of these two is unavoidable - but neither is a copy-paste of
        # two lines.
        case "${1:-}" in
            install)
                dest="${BASH_COMPLETION_USER_DIR:-$HOME/.local/share/bash-completion}/completions"
                mkdir -p "$dest"
                cp "$HERE/tools/devkit-completion.bash" "$dest/devkit"
                echo "installed: $dest/devkit"
                echo "Every new shell will have it. For this one:"
                echo "    source $dest/devkit"
                echo "To undo:  rm $dest/devkit" ;;
            -h|--help)
                echo "usage: ./devkit completion [install]"
                echo
                echo "  (no argument)  print the script, for:"
                echo "                     source <(./devkit completion)"
                echo "  install        install it for every new shell" ;;
            *)  cat "$HERE/tools/devkit-completion.bash" ;;
        esac
        exit 0 ;;

    status)
        echo "== repo =="
        echo "   $(git -C "$HERE" log --oneline -1 2>/dev/null || echo 'not a git checkout')"
        echo
        if [ "$TARGET" = modern ]; then
            echo "== modern source =="
            [ -f "$FWM/src/linux/Makefile" ] && echo "   kernel: present" || echo "   kernel: missing - run ./devkit setup --target modern"
            [ -f "$FWM/boot/fw/u-boot-xlnx/Makefile" ] && echo "   boot:   present (U-Boot, embeddedsw, bootgen)" \
                || echo "   boot:   missing - run ./devkit setup --target modern"
            echo
            echo "== last modern build =="
            for f in BOOT.bin uImage devicetree.dtb uEnv.txt system_top.xsa; do
                if [ -r "$FWM/output/$f" ]; then printf '   %-22s %10s B  %s\n' "$f" \
                    "$(stat -c%s "$FWM/output/$f")" "$(date -r "$FWM/output/$f" '+%Y-%m-%d %H:%M')"
                else printf '   %-22s -\n' "$f"; fi
            done
            if [ -r "$FWM/debian/rootfs.tar" ]; then printf '   %-22s %10s B  %s  (debian/, for write-card)\n' rootfs.tar \
                "$(stat -c%s "$FWM/debian/rootfs.tar")" "$(date -r "$FWM/debian/rootfs.tar" '+%Y-%m-%d %H:%M')"
            else printf '   %-22s -\n' "rootfs.tar"; fi
            echo
            board_status
            exit 0
        fi
        echo "== source tree =="
        if [ -d "$FW/src/.git" ]; then
            stamp="$FW/src/.devkit-patches-applied"
            if [ ! -f "$stamp" ]; then
                echo "   src/ present, patches NOT applied - run ./devkit setup"
            else
                missing=0
                for p in "$FW"/patches/*.patch; do
                    grep -qxF "$(sha256sum "$p" | cut -d' ' -f1)  $(basename "$p")" "$stamp" \
                        || missing=$((missing+1))
                done
                if [ "$missing" -eq 0 ]; then
                    echo "   src/ present, all $(ls "$FW"/patches/*.patch | wc -l) patches applied"
                else
                    echo "   src/ present, $missing patch(es) not applied - run ./devkit setup"
                fi
            fi
        else
            echo "   src/ missing - run ./devkit setup"
        fi
        echo
        echo "== last build =="
        if [ -r "$FW/output/BOOT.bin" ]; then
            for f in BOOT.bin devicetree.dtb uEnv.txt uImage uramdisk.image.gz; do
                [ -r "$FW/output/$f" ] && printf '   %-20s %10s B  %s\n' "$f" \
                    "$(stat -c%s "$FW/output/$f")" "$(date -r "$FW/output/$f" '+%Y-%m-%d %H:%M')"
            done
        else
            echo "   nothing in output/ - run ./devkit build"
        fi
        echo
        board_status
        ;;

    *)  _m="$(suggest "$cmd")"
        echo "unknown command: $cmd${_m:+ - did you mean '$_m'?}" >&2
        echo "./devkit help lists them all." >&2
        exit 2 ;;
esac
