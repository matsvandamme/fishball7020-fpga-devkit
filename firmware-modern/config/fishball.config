# Kernel options this board needs that ADI's zynq_pluto_defconfig does not set.
#
# Applied on top of zynq_pluto_defconfig with scripts/kconfig/merge_config.sh.
# Every line here is a delta the ADALM-Pluto genuinely does not need, which is
# why upstream omits it - this board is a Pluto-compatible with more hardware
# bolted on, and each group below is a piece of that hardware.
#
# Derived by diffing the vendor's 5.15 zynq_pluto_defconfig against ADI's, not
# by guessing: 26 options differ and these are the ones that matter. The first
# attempt shipped without them and produced a board that booted perfectly,
# probed the AD9361, and had neither Ethernet nor an SD card.

# --- Ethernet -----------------------------------------------------------
# The Pluto is a USB gadget and has no Ethernet at all. This board has a
# Cadence GEM in the PS driving an RTL8211F over RGMII to an RJ45.
# OF_MDIO is not optional: without it `phy-handle` in the device tree goes
# nowhere and the MAC comes up with no PHY.
CONFIG_ETHERNET=y
CONFIG_MACB=y
CONFIG_REALTEK_PHY=y
CONFIG_OF_MDIO=y

# --- SD card ------------------------------------------------------------
# U-Boot reads the card through the BootROM and does not need Linux to have a
# driver, so a kernel without these still BOOTS - it simply cannot see
# /dev/mmcblk0 afterwards. That breaks tools/flash.sh, which mounts
# /dev/mmcblk0p1 on the running board, and with it the entire
# flash-over-the-network route. Learned the hard way.
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_OF_ARASAN=y

# --- Gates the options below need ---------------------------------------
# GPIO_SYSFS is declared `bool "..." if EXPERT`, so without EXPERT it silently
# takes its default and no amount of asking for it in a fragment helps. The
# vendor's 5.15 config got EXPERT for free via CONFIG_EMBEDDED, which 6.12
# removed. DEBUG_LL likewise depends on DEBUG_KERNEL.
CONFIG_EXPERT=y
CONFIG_DEBUG_KERNEL=y

# --- GPIO through sysfs -------------------------------------------------
# tools/tx-gpio-bitmap-check.py (`./devkit gpio-check`) drives the four
# sample-locked pins through /sys/class/gpio. Deprecated upstream in favour of
# the character device, but it is what the tooling here uses today.
CONFIG_GPIO_SYSFS=y

# --- LED triggers -------------------------------------------------------
# The USER LED follows the transmitter via a trigger selected from userspace
# at boot, deliberately not from the device tree.
CONFIG_LEDS_TRIGGER_GPIO=y

# --- Early console ------------------------------------------------------
# So that a kernel which dies before the real console is up still says why.
# Worth having permanently on a board whose only other diagnostic is a blinking
# LED.
CONFIG_DEBUG_LL=y
CONFIG_DEBUG_ZYNQ_UART1=y
CONFIG_EARLY_PRINTK=y

# --- Watchdog on a wedged kernel ---------------------------------------
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=20

# --- Odds and ends the vendor tree carried ------------------------------
# NOT carried over: CONFIG_USB_ULPI. The vendor's 5.15 set it for the USB3320C
# ULPI PHY, but on 6.12 it fails to link - phy-ulpi.c needs usb_add_phy_dev()
# from CONFIG_USB_PHY, which the pluto defconfig does not set. It is also
# demonstrably unnecessary: the USB gadget came up on the first 6.12 boot
# without it, which is how this board was reachable at all after Ethernet
# failed. Do not add config symbols speculatively.
CONFIG_CRYPTO_ECB=y
CONFIG_INPUT_FF_MEMLESS=y
CONFIG_RFKILL_INPUT=y
