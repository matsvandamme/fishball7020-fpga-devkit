// SPDX-License-Identifier: GPL-2.0
/*
 * PlutoSky R2 - Zynq XC7Z020-CLG484 + AD9361 (or AD9363, by SKU), two receive
 * and two transmit chains, Gigabit Ethernet on the FPGA, a 10 MHz reference
 * input.
 *
 * THIS IS THE R1's TREE WITH THE R2's DIFFERENCES ON TOP, and nothing else:
 * it includes zynq-pluto-sdr-fishball.dts and overrides. The radio, the SD
 * card, the DMA channels, the flash layout and the sample-GPIO names are the
 * R1's and are not repeated here, so a fix to one of them reaches both boards.
 * In particular the transmit attenuation the driver probes with (89.75 dB,
 * the muted state) is inherited - do not restate it here, where it could
 * drift from the R1's.
 *
 * WHERE EACH DIFFERENCE COMES FROM. Not from reading the board by eye: from
 * the R2's own factory device tree, read off a running unit (/sys/firmware/fdt
 * under its QSPI firmware v0.38-5-g76414-dirty, 2026-11-18) and diffed against
 * this repo's R1 tree, and from the vendor's source for that firmware,
 *     github.com/OpenSourceSDRLab/PlutoSky-R2, the patch in firmware/source
 * The two agree on every value below.
 *
 * NOT YET BOOTED. Written on 2026-11-18, before an R2 bitstream of this
 * repo's design existed to boot it with. Ethernet in particular is the
 * vendor's 5.15 description carried to 6.12, where the MAC driver is the
 * same but the GMII-to-RGMII glue is mainline's rather than Xilinx's.
 *
 * Needs CONFIG_XILINX_GMII2RGMII, which the R1 does not: config/r2.config.
 *
 * Copyright (C) 2026 Matthieu
 */
#include "zynq-pluto-sdr-fishball.dts"

/ {
	/*
	 * "PlutoSDR" stays in the string because host software finds the
	 * board by it; "FISH Ball" because this repo's own tools print it.
	 */
	model = "FISH Ball PlutoSDR R2 (Z7020/AD9361)";

	leds {
		led0 {
			/*
			 * MIO 7 on the R2; the R1's is MIO 0. The LABEL stays
			 * "led0:green" although the factory tree calls this one
			 * "led0:yellow": the userspace that makes the LED follow
			 * the transmitter opens /sys/class/leds/led0:green, and a
			 * transmit indicator that silently stops working is worse
			 * than a colour that is wrong in a path name.
			 */
			gpios = <&gpio0 7 0>;
		};
	};
};

/*
 * Ethernet. The largest difference between the two boards.
 *
 * R1: the RTL8211F hangs off PS MIO 16-27 (RGMII) and MIO 52/53 (MDIO), at
 *     PHY address 0. The MAC talks to it directly.
 * R2: those MIO pins are plain GPIO. GEM0 comes out through EMIO as GMII into
 *     a Xilinx gmii_to_rgmii core in the FPGA, and the core's RGMII side goes
 *     to the RTL8211F on bank-35 pins. The core answers on the same MDIO bus
 *     at address 8 (it has one register: the speed it should convert at); the
 *     PHY is at address 1.
 *
 * So the R1's PHY node is removed rather than edited - there is nothing at
 * address 0 - and two nodes replace it. The kernel's xilinx_gmii2rgmii driver
 * binds the converter node, finds the PHY through its phy-handle, and hooks
 * the PHY's link-state read so that every time the link changes it writes the
 * negotiated speed into the core (register 0x10). Without that driver nothing
 * writes it, and the core stays at whatever speed it resets to.
 *
 * phy-mode is NOT the factory tree's value. That says "rgmii-rxid", and on
 * 6.12 the Realtek driver takes it literally and switches the RTL8211F's
 * transmit-clock delay off (page 0xd08, register 0x11, bit 8). Measured on an
 * R2 on 2026-11-20: with it off the link comes up at 1 Gbit/s and receives,
 * but nothing the board sends arrives - DHCP never completes. Setting the bit
 * by hand made DHCP and ping work at once. "rgmii-id" keeps both delays on,
 * which is what the board needs: neither the FPGA core nor the traces add one.
 */
/delete-node/ &ethernet_phy;

&gem0 {
	phy-mode = "rgmii-id";
	phy-handle = <&ethernet_phy_r2>;

	ethernet_phy_r2: ethernet-phy@1 {
		reg = <1>;
		/*
		 * Generic clause 22, as on the R1: the driver is chosen from
		 * the ID the chip reports. The factory tree instead names
		 * "ethernet-phy-id011c.c916", which is not the RTL8211F's ID
		 * (001c.c916) and matches the Realtek driver only because of
		 * that driver's mask.
		 */
		compatible = "ethernet-phy-ieee802.3-c22";
	};

	gmii_to_rgmii: gmiitorgmii@8 {
		compatible = "xlnx,gmii-to-rgmii-1.0";
		reg = <8>;
		phy-handle = <&ethernet_phy_r2>;
	};
};

/*
 * The USB3320's reset is MIO 46, active high, on the R2; ADI's dtsi says
 * MIO 52, active low, which on this board is not the PHY's reset at all.
 * The factory tree's value.
 *
 * This is NOT what makes USB work on the R2. With an R1 boot image the pin was
 * already high and USB was still dead: that image configures MIO bank 501 for
 * 1.8 V and the R2 powers it at 3.3 V. The bank voltage comes from the FSBL,
 * which is generated from the XSA - so it is the R2 XSA that fixes USB, and
 * this property only stops the tree describing a pin the board does not have.
 */
&usb0 {
	xlnx,phy-reset-gpio = <&gpio0 46 0>;
};
